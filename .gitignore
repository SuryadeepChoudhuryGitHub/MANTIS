# =============================================================================
# PROJECT ARES — Git Ignore Specification
# =============================================================================

# CMake and Compiler Build Directories
build/
build-*/
build_*/
bin/
lib/
out/
x64/
x86/
ARM64/
cmake-build-*/

# Temporary & Scratch Files
scratch/
obj_temp/
*.blend
*.blend1
*.blend2

# Compiled Object Files and Binaries
*.obj
*.o
*.lib
*.a
*.exe
*.dll
*.so
*.dylib
*.pdb
*.idb
*.ilk
*.exp

# Visual Studio & MSBuild Internals
.vs/
*.tlog
*.lastbuildstate
*.recipe
*.vcxproj.user
*.vcxproj.filters
*.sln.docstates
*.VC.db
*.VC.opendb

# CMake In-Source Artifacts (if invoked without build directory)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Python Virtual Environs & Bytecode (for preprocessing scripts)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# Large Raw Geospatial & Orbital Datasets (>100MB; use scripts/preprocess_mars_dtm.py)
*.tif
*.tiff
*.geotiff

# OS-Specific Metadata & Logs
.DS_Store
Thumbs.db
*.log
*.tmp
*.dmp
